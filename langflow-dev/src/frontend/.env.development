# Development environment variables
VITE_NODE_ENV=development
VITE_BACKEND_URL=https://essedum.az.ad.idemo-ppc.com
VITE_PORT=3000
# Set to 'true' to test production proxy behavior locally
VITE_FORCE_PRODUCTION_PROXY=true
# Set to 'true' to ignore SSL certificate errors when proxying to production
VITE_IGNORE_SSL_CERTS=true
