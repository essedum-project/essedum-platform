
apiVersion: apps/v1
kind: Deployment
metadata:
  name: builder-service
  namespace: aipns
spec:
  replicas: 1
  selector:
    matchLabels:
      app: builder
  template:
    metadata:
      labels:
        app: builder
    spec:
      serviceAccountName: builder-sa  # Grants permission per RBAC
      nodeSelector:
        kubernetes.io/arch: arm64
      containers:
        - name: builder
          image:  localhost:32000/builder-service:latest
          imagePullPolicy: Always
          ports:
            - containerPort: 5000
          env:
            - name: BUILDKIT_ADDR
              value: "tcp://buildkitd:1234"   # Points to your buildkitd Service
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: DOCKER_CONFIG
              value: "/root/.docker"
          volumeMounts:
            - name: dockerfile-template
              mountPath: /opt/fallback
      volumes:
        - name: dockerfile-template
          configMap:
            name: adk-dockerfile-template
---
apiVersion: v1
kind: Service
metadata:
  name: builder-service
  namespace: aipns
spec:
  selector:
    app: builder
  ports:
    - port: 80
      targetPort: 5000
  type: ClusterIP
