FROM python:3.11-slim

# Langflow Stable - PostgreSQL enabled build
LABEL maintainer="devops"
LABEL description="Langflow Stable with PostgreSQL support"

ENV PIP_NO_CACHE_DIR=1 \
        PYTHONDONTWRITEBYTECODE=1 \
        PYTHONUNBUFFERED=1

# System deps for PostgreSQL psycopg2 and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m appuser
WORKDIR /app

COPY requirements.langflow-stable.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
        && pip install --no-cache-dir -r requirements.txt

# Create data dir and ensure permissions
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Expose port — actual port is controlled by LANGFLOW_PORT in .env
EXPOSE ${LANGFLOW_PORT:-7861}

USER appuser

# Entrypoint: run LangFlow
# All config (LANGFLOW_DATABASE_URL, LANGFLOW_SECRET_KEY, LANGFLOW_HOST, LANGFLOW_PORT) comes from .env
CMD ["bash", "-lc", "langflow run --host ${LANGFLOW_HOST} --port ${LANGFLOW_PORT}"]
