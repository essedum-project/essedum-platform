# Example .env file for essedum-platform
# Copy this file to .env and fill in your actual values

# Security Keys (REQUIRED - Generate secure random strings)
ENCRYPTION_KEY=
ENCRYPTION_SALT=
LICENSE=
PUBLIC_KEY=

# Application Ports
BACKEND_PORT=8082
FRONTEND_PORT=8084
PYJOB_EXECUTOR_PORT=5001
PYJOB_SAGEMAKER_EXECUTER_PORT=5002
PYJOB_VERTEX_EXECUTER_PORT=5007

# AWS Configuration (Optional - Required for AWS/SageMaker features)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
SAGEMAKER_ROLE=
AWS_REGION=us-east-1

# MinIO Configuration (Object Storage)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BROWSER=on
MINIO_PROMETHEUS_AUTH_TYPE=public
MINIO_SERVER_URL=

# Google Cloud Configuration (Optional - Required for Vertex AI features)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=

# Azure Configuration (Optional - Required for Azure features)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# GitHub OAuth Configuration (Optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# MySQL Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATASOURCE_URL=
MYSQL_DATASOURCE_USER=
MYSQL_DATASOURCE_PASSWORD=

# Qdrant Configuration
QDRANT_PORT=6333

# Keycloak Configuration
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180

# External URLs (Replace with your actual host/IP)
EXTERNAL_ISSUER_URI=
EXTERNAL_BASE_URL=
EXTERNAL_KC_URL=
EXTERNAL_AUTH_URL=

# Frontend Configuration URLs
EXTERNAL_BASE_URL=
EXTERNAL_KC_URL=
EXTERNAL_AUTH_URL=
 
 
MYSQL_DATASOURCE_URL=
MYSQL_DATASOURCE_USER=
MYSQL_DATASOURCE_PASSWORD=
# --- Frontend: Langflow / Langfuse / LiteLLM URLs ---
FE_LANGFLOW_URL= 
FE_LANGFUSE_URL=
FE_LITELLM_URL=
FE_SALUS_URL="/salus/shell/#/"
# --- Frontend: Pipeline Config ---
FE_MINIO_ENDPOINT=
FE_MINIO_BUCKET=aiptest
FE_CONTAINER_REGISTRY_PREFIX=localhost:5000
FE_CONTAINER_REGISTRY_VERSION=latest

# Langflow Stable (PostgreSQL) Configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433

LANGFLOW_DATABASE_URL=
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_SECRET_KEY=
LANGFLOW_HTTPS_PORT=8086

# LiteLLM Configuration
LITELLM_DB_PASSWORD=
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
LITELLM_MASTER_KEY=
LITELLM_LOG_LEVEL=INFO
LITELLM_UI_USERNAME=
LITELLM_UI_PASSWORD=
LITELLM_HTTPS_PORT=4000

# Langfuse Configuration
LANGFUSE_POSTGRES_USER=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=
LANGFUSE_POSTGRES_PORT=5434
LANGFUSE_HTTPS_PORT=8087
LANGFUSE_DB_HTTPS_PORT=8089

# Langfuse Database
LANGFUSE_DATABASE_URL=

# Langfuse Security
SALT=
LANGFUSE_ENCRYPTION_KEY=
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Langfuse Features
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true

# ClickHouse Configuration
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_MIGRATION_URL=
CLICKHOUSE_URL=
# Redis Configuration
REDIS_PASSWORD=
REDIS_HOST_PORT=6379
REDIS_CONNECTION_STRING=

# Langfuse MinIO Configuration
MINIO_API_PORT=9100
LANGFUSE_MINIO_CONSOLE_PORT=9101
MINIO_REGION=us-east-1
MINIO_BUCKET=langfuse
LANGFUSE_S3_ENDPOINT=
LANGFUSE_S3_FORCE_PATH_STYLE=true

# Langfuse Service Ports
WORKER_HOST_PORT=3030
WEB_HOST_PORT=3000

# Langfuse Keys (for LiteLLM integration)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
# ADK Code Builder Deployer
ADK_DEPLOYER_PORT=5001

# Vibe Code Builder Configuration
BUILDKIT_ADDR=
REGISTRY_URL=<cluster-ip>:5000
PYTHONUNBUFFERED=1
MINIO_ENDPOINT=
AWS_ACCESS_KEY_ID=<your-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-secret-access-key>

