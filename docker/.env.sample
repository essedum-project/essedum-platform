# =============================================================================
# Essedum Platform — Environment Configuration
# This file stays on the VM only. Never commit to GitHub.
# Location: /home/devopsuser/devops/actions/essedum-platform/docker/.env.sample
# Copy to .env before use: cp .env.sample .env
# =============================================================================

# --- Core Platform ---
ENCRYPTION_KEY=
ENCRYPTION_SALT=
LICENSE=
PUBLIC_KEY=

# --- Service Ports ---
BACKEND_PORT=8082
FRONTEND_PORT=8084
PYJOB_EXECUTOR_PORT=5001
PYJOB_SAGEMAKER_EXECUTER_PORT=5002
PYJOB_VERTEX_EXECUTER_PORT=5007
ADK_DEPLOYER_PORT=5003

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATASOURCE_URL=
MYSQL_DATASOURCE_USER=
MYSQL_DATASOURCE_PASSWORD=

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
KC_DB_NAME=
KC_DB_USERNAME=
KC_DB_PASSWORD=

# --- MinIO (shared) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER=on
MINIO_PROMETHEUS_AUTH_TYPE=public
MINIO_SERVER_URL=
MINIO_REGION=

# --- Qdrant ---
QDRANT_PORT=6333

# --- Redis ---
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_AUTH=
REDIS_CONNECTION_STRING=

# --- ClickHouse ---
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_MIGRATION_URL=
CLICKHOUSE_URL=

# --- External URLs ---
EXTERNAL_ISSUER_URI=
EXTERNAL_BASE_URL=
EXTERNAL_KC_URL=
EXTERNAL_AUTH_URL=
NEXTAUTH_URL=

# --- Frontend Config ---
FE_LANGFLOW_URL=
FE_LANGFUSE_URL=
FE_LITELLM_URL=
FE_MINIO_ENDPOINT=
FE_MINIO_BUCKET=
FE_CONTAINER_REGISTRY_PREFIX=${DOCKER_REGISTRY}
FE_CONTAINER_REGISTRY_VERSION=${IMAGE_TAG}
FE_SALUS_URL=

# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AWS / Cloud ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_REGION=us-east-1
SAGEMAKER_ROLE=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# =============================================================================
# --- Langflow ---
# =============================================================================
LANGFLOW_DATABASE_URL=
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_ENV=
LANGFLOW_SECRET_KEY=
LANGFLOW_AUTO_LOGIN=false
LANGFLOW_HTTPS_PORT=8086
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433


# =============================================================================
# --- Goose / Vibe Studio ---
# =============================================================================
GOOSE_SERVER__SECRET_KEY=
GOOSE_HOST=0.0.0.0
GOOSE_PORT=3005
GOOSE_TLS=false
GOOSE_WORKING_DIR=
GOOSE_PATH=
GOOSE_MINIO_UPLOAD_ENABLED=false
GOOSE_MINIO_ENDPOINT=
GOOSE_MINIO_BUCKET=
GOOSE_MINIO_REGION=
GOOSE_MINIO_TLS_SKIP_VERIFY=false
GOOSE_MINIO_ACCESS_KEY=
GOOSE_MINIO_SECRET_KEY=

# =============================================================================
# --- Vibe Code Builder Deployer ---
# =============================================================================
REGISTRY_URL=
VIBE_BUILDKIT_ADDR=

# =============================================================================
# --- GitHub Actions Runner ---
# =============================================================================
GITHUB_TOKEN=
GITHUB_OWNER=
RUNNER_NAME=
RUNNER_LABELS=

# --- Deploy Mode ---
DEPLOY_MODE=docker

# NPM Registry — public registry (Infosys Artifactory is blocked in this environment)
# All frontend microservice builds use this registry. Lock files are auto-removed before build.
NPM_REGISTRY_URL=
NPM_AUTH_TOKEN=

# =============================================================================
# --- UNIVERSAL KUBERNETES DEPLOYMENT  
# =============================================================================
# These variables drive build-and-push.sh and deploy.sh identically across
# every cluster.  Change only THIS block when switching environments.
# -----------------------------------------------------------------------------

# ── Environment Selector ──────────────────────────────────────────────────────

ENVIRONMENT=lfn
machine_ip=

# ── Container Registry ───────────────────────────────────────────────────────
DOCKER_REGISTRY=
DOCKER_USERNAME=
DOCKER_PASSWORD=
# Image tag applied to every image that is built and pushed
IMAGE_TAG=lfn-v15

# ── Kubernetes Cluster ───────────────────────────────────────────────────────
# Run: kubectl config get-contexts   to list available context names
KUBE_CONTEXT=
KUBE_NAMESPACE=aipns
# Leave blank to use default ~/.kube/config
KUBE_CONFIG_PATH=

# ── Vibe Studio Namespaces ───────────────────────────────────────────────────
VIBE_APPS_NAMESPACE=vibe-apps
VIBE_MCP_NAMESPACE=vibe-mcp
VIBE_AGENTS_NAMESPACE=vibe-agents

# ── Image Names (registry prefix and tag are added by scripts) ───────────────
UI_IMAGE=essedum-ui
API_GATEWAY_IMAGE=essedum-api-gateway
USM_IMAGE=essedum-usm-service
ICIP_IMAGE=essedum-icip-service
DATA_IMAGE=essedum-data-service
VIBE_IMAGE=essedum-vibe-service
PYJOB_IMAGE=pyjob-excecutor
AGENT_DESIGNER_IMAGE=agent-designer-backend
FRONTEND_SHELL_IMAGE=essedum-frontend-shell
FRONTEND_AGENT_IMAGE=essedum-frontend-agent
FRONTEND_AGENT_DESIGNER_IMAGE=essedum-frontend-agent-designer
FRONTEND_DATA_OPS_IMAGE=essedum-frontend-data-ops
FRONTEND_INTEGRATION_IMAGE=essedum-frontend-integration
FRONTEND_VIBE_STUDIO_IMAGE=essedum-frontend-vibe-studio

# ── Database (Kubernetes internal DNS) ───────────────────────────────────────
DB_HOST=
DB_NAME=

# ── Keycloak Realm ───────────────────────────────────────────────────────────
KEYCLOAK_REALM=

# ── Ingress & TLS ────────────────────────────────────────────────────────────
INGRESS_HOST=essedum.local
INGRESS_HOST_LFN=essedum.local
KEYCLOAK_INGRESS_HOST=keycloak.essedum.local
TLS_SECRET_NAME=
INGRESS_CLASS=nginx

# ── Resource Limits — Backend Services ───────────────────────────────────────
BACKEND_REPLICAS=1
BACKEND_CPU_REQUEST=500m
BACKEND_CPU_LIMIT=2000m
BACKEND_MEM_REQUEST=512Mi
BACKEND_MEM_LIMIT=4Gi

# ── Resource Limits — Frontend Services ──────────────────────────────────────
FRONTEND_REPLICAS=1
FRONTEND_CPU_REQUEST=100m
FRONTEND_CPU_LIMIT=500m
FRONTEND_MEM_REQUEST=128Mi
FRONTEND_MEM_LIMIT=512Mi