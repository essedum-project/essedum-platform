# =============================================================================
# Essedum Platform — Environment Configuration
# Copy to .env before use: cp .env.sample .env
# =============================================================================

# --- Core Platform ---
ENCRYPTION_KEY=
ENCRYPTION_SALT=
LICENSE=
PUBLIC_KEY=

# --- Service Ports ---
BACKEND_PORT=8082
FRONTEND_PORT=8084
PYJOB_EXECUTOR_PORT=5001
PYJOB_SAGEMAKER_EXECUTER_PORT=5002
PYJOB_VERTEX_EXECUTER_PORT=5007
ADK_DEPLOYER_PORT=5003

# --- MySQL ---
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
MYSQL_DATASOURCE_URL=
MYSQL_DATASOURCE_USER=
MYSQL_DATASOURCE_PASSWORD=
# Spring service vars referenced directly by backend YAMLs (MYSQL_USER / MYSQL_PASSWORD)
MYSQL_USER=
MYSQL_PASSWORD=


# # Spring service vars referenced directly by backend YAMLs (Postgress_USER / Postgress_PASSWORD) 

PG_DATASOURCE_URL=
PG_USER=
PG_PASSWORD=
SERVICE_ACCESS_TOKEN=
SERVICE_PROXY_USER=


# --- Keycloak ---
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_PORT=8180
KC_DB_NAME=
KC_DB_USERNAME=
KC_DB_PASSWORD=

# --- MinIO (shared) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER=on
MINIO_PROMETHEUS_AUTH_TYPE=
MINIO_SERVER_URL=
MINIO_REGION=

# --- Qdrant ---
QDRANT_PORT=6333

# --- Redis ---
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_AUTH=
REDIS_CONNECTION_STRING=

# --- External URLs ---
EXTERNAL_ISSUER_URI=

# --- Frontend Nginx runtime upstreams ---
# Override to point the Nginx reverse proxy at a different backend or Keycloak.
# Defaults match Docker Compose service names and K8s service names.
ESSEDUM_BACKEND_UPSTREAM=
ESSEDUM_KEYCLOAK_UPSTREAM=

# Keycloak issuer URL injected into auth-config.json at container startup.
# Required when deploying via Docker Compose (K8s uses a ConfigMap instead).
# Format: https://<your-keycloak-host>/realms/<realm-name>
KEYCLOAK_ISSUER=
 
# Frontend Configuration URLs
EXTERNAL_BASE_URL=
EXTERNAL_KC_URL=
EXTERNAL_AUTH_URL=
NEXTAUTH_URL=


# --- GitHub OAuth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vibe Studio GitHub Integration ---
VIBE_GITHUB_ENABLED=true
VIBE_GITHUB_REPO_URL=
VIBE_GITHUB_USERNAME=
VIBE_GITHUB_TOKEN=
VIBE_GITHUB_WORK_DIR=

# --- AWS / Cloud ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_REGION=us-east-1
SAGEMAKER_ROLE=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=


# =============================================================================
# --- Goose / Vibe Studio ---
# =============================================================================
GOOSE_SERVER__SECRET_KEY=
GOOSE_HOST=
GOOSE_PORT=3005
GOOSE_TLS=
GOOSE_WORKING_DIR=
GOOSE_PATH=
GOOSED_WRAPPER_PATH=
GOOSE_MINIO_UPLOAD_ENABLED=
GOOSE_MINIO_ENDPOINT=
GOOSE_MINIO_BUCKET=
GOOSE_MINIO_REGION=
GOOSE_MINIO_TLS_SKIP_VERIFY=
GOOSE_MINIO_ACCESS_KEY=
GOOSE_MINIO_SECRET_KEY=


# =============================================================================
# --- Vibe Code Builder Deployer ---
# =============================================================================
REGISTRY_URL=
VIBE_BUILDKIT_ADDR=

# =============================================================================
# --- GitHub Actions Runner ---
# =============================================================================
GITHUB_TOKEN=
GITHUB_OWNER=
RUNNER_NAME=
RUNNER_LABELS=

# --- Deploy Mode ---
DEPLOY_MODE=

# =============================================================================
# --- Build Registry Configuration (NPM + Maven) ---
# =============================================================================
# Environment-specific registry selection:
#
#   AKS      : Set REGISTRY_USER + REGISTRY_TOKEN (one JFrog identity token
#              covers both npm frontend builds and Maven backend builds).
#              Optionally override NPM_AUTH_TOKEN / ARTIFACTORY_REPO_USER/PASS
#              for per-tool tokens if your Artifactory policies require it.
#   5G / LFN : Leave REGISTRY_USER, REGISTRY_TOKEN (and NPM_REGISTRY_URL) empty
#              and set MAVEN_SETTINGS_FILE=maven-settings-public.xml
#              -> builds resolve directly from Maven Central + public npm
# -----------------------------------------------------------------------------

# -- NPM Registry URL --------------------------------------------------------
# AKS: set to Artifactory npm endpoint.  5G / LFN: leave empty.
NPM_REGISTRY_URL=

# -- Unified registry credentials (replaces NPM_AUTH_TOKEN + ARTIFACTORY_*) --
# REGISTRY_USER : Infosys AD email  (Maven <username>; npm does not use username)
# REGISTRY_TOKEN: JFrog identity token — works for BOTH npm _authToken AND Maven
# 5G / LFN: leave both empty.
REGISTRY_USER=
REGISTRY_TOKEN=

# -- Maven Settings File ------------------------------------------------------
# AKS      : maven-settings.xml         (Artifactory mirror, credentials required)
# 5G / LFN : maven-settings-public.xml  (Maven Central directly, no credentials)
MAVEN_SETTINGS_FILE=
# =============================================================================
# --- UNIVERSAL KUBERNETES DEPLOYMENT  
# =============================================================================
# These variables drive build-and-push.sh and deploy.sh identically across
# every cluster.  Change only THIS block when switching environments.
# -----------------------------------------------------------------------------

# ── Environment Selector ──────────────────────────────────────────────────────

ENVIRONMENT=

# -- DB Wipe Protection -------------------------------------------------------
# true  : deploy.sh verifies mysql-pvc and qdrant-pvc are Bound before deploying
#         (safe default for existing clusters -- prevents accidental data loss)
# false : skip the PVC check (use ONLY for brand-new cluster first install)
DB_WIPE_PROTECTION=

# -- MetalLB ------------------------------------------------------------------
# true  : skip MetalLB config apply (AKS uses Azure LB -- no MetalLB needed)
# false : apply MetalLB config (5G / LFN bare-metal clusters)
SKIP_METALLB=
machine_ip=

# ── Container Registry ───────────────────────────────────────────────────────
DOCKER_REGISTRY=
# ACR credentials — choose ONE option:
#   Option A (recommended): Leave blank and run 'az login' + 'az acr login'
#                           build-and-push.sh will call az acr login automatically.
#   Option B: Fill in ACR admin credentials from:
#             az acr credential show --name 
#             Use outputPassword (username = registry name)
DOCKER_USERNAME=
DOCKER_PASSWORD=
# Image tag applied to every image that is built and pushed
IMAGE_TAG=

# ── Kubernetes Cluster ───────────────────────────────────────────────────────
# Run: kubectl config get-contexts   to list available context names
KUBE_CONTEXT=
KUBE_NAMESPACE=
# Leave blank to use default ~/.kube/config
KUBE_CONFIG_PATH=

# ── Vibe Studio Namespaces ───────────────────────────────────────────────────
VIBE_APPS_NAMESPACE=vibe-apps
VIBE_MCP_NAMESPACE=vibe-mcp
VIBE_AGENTS_NAMESPACE=vibe-agents

# ── Image Names (registry prefix and tag are added by scripts) ───────────────
UI_IMAGE=essedum-ui
API_GATEWAY_IMAGE=essedum-api-gateway
USM_IMAGE=essedum-usm-service
ICIP_IMAGE=essedum-icip-service
DATA_IMAGE=essedum-data-service
VIBE_IMAGE=essedum-vibe-service
PYJOB_IMAGE=pyjob-excecutor
AGENT_DESIGNER_IMAGE=agent-designer-backend
AGENT_DESIGNER_URL=
FRONTEND_SHELL_IMAGE=essedum-frontend-shell
FRONTEND_AGENT_IMAGE=essedum-frontend-agent
FRONTEND_AGENT_DESIGNER_IMAGE=essedum-frontend-agent-designer
FRONTEND_DATA_OPS_IMAGE=essedum-frontend-data-ops
FRONTEND_INTEGRATION_IMAGE=essedum-frontend-integration
FRONTEND_VIBE_STUDIO_IMAGE=essedum-frontend-vibe-studio

# ── Database (Kubernetes internal DNS) ───────────────────────────────────────
DB_HOST=
DB_NAME=

# ── Keycloak Realm ───────────────────────────────────────────────────────────
KEYCLOAK_REALM=

# ── Ingress & TLS ────────────────────────────────────────────────────────────
INGRESS_HOST=
INGRESS_HOST_LFN=
KEYCLOAK_INGRESS_HOST=
TLS_SECRET_NAME=
INGRESS_CLASS=

# ── Resource Limits — Backend Services ───────────────────────────────────────
BACKEND_REPLICAS=1
BACKEND_CPU_REQUEST=500m
BACKEND_CPU_LIMIT=2000m
BACKEND_MEM_REQUEST=512Mi
BACKEND_MEM_LIMIT=4Gi

# ── Resource Limits — Frontend Services ──────────────────────────────────────
FRONTEND_REPLICAS=1
FRONTEND_CPU_REQUEST=100m
FRONTEND_CPU_LIMIT=500m
FRONTEND_MEM_REQUEST=128Mi
FRONTEND_MEM_LIMIT=512Mi
SKIP_ONE_TOUCH_BACKUP=true
OAUTH2_ISSUER_URI=
OAUTH2_JWK_URI=
OAUTH2_CLIENT_ID=
OAUTH2_SCOPE=
OAUTH2_USER_CLAIM=
