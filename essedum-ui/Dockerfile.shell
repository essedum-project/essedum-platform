# Build context: essedum-platform/ (repo root)
FROM node:20-alpine AS build

ARG NPM_REGISTRY_URL
ARG NPM_AUTH_TOKEN
ARG NPM_ALWAYS_AUTH=true

# Configure Artifactory npm registry when credentials are supplied
RUN if [ -n "${NPM_REGISTRY_URL}" ] && [ -n "${NPM_AUTH_TOKEN}" ]; then \
      REGISTRY_HOST=$(echo "${NPM_REGISTRY_URL}" | sed 's|https:||'); \
      echo "registry=${NPM_REGISTRY_URL}" >> /root/.npmrc && \
      echo "${REGISTRY_HOST}:_authToken=${NPM_AUTH_TOKEN}" >> /root/.npmrc && \
      echo "always-auth=${NPM_ALWAYS_AUTH}" >> /root/.npmrc && \
      echo "strict-ssl=false" >> /root/.npmrc; \
    fi

WORKDIR /workspace
COPY essedum-ui/shell/ ./shell/
WORKDIR /workspace/shell
RUN rm -f package-lock.json yarn.lock
RUN npm install --legacy-peer-deps
RUN npm run build-prod || (echo "=== Angular error log ===" && cat /tmp/ng-*/angular-errors.log 2>/dev/null && exit 1)
# apk CDN uses HTTPS which is blocked by TLS proxy — switch to HTTP mirror to install openssl.
RUN sed -i 's|https://dl-cdn.alpinelinux.org|http://dl-cdn.alpinelinux.org|g' /etc/apk/repositories && \
	apk add --no-cache openssl && \
	openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
		-subj "/CN=localhost" \
		-keyout /tmp/server.key \
		-out /tmp/server.crt && \
	apk del openssl

FROM nginx:alpine
RUN mkdir -p /etc/nginx/ssl
# Copy pre-generated cert from the build stage (no apk needed at runtime).
COPY --from=build /tmp/server.key /etc/nginx/ssl/server.key
COPY --from=build /tmp/server.crt /etc/nginx/ssl/server.crt

COPY essedum-ui/nginx_shell.conf /etc/nginx/nginx.conf.template
WORKDIR /app
RUN mkdir -p /app/ui/shell
COPY --from=build /workspace/shell/dist/shell /app/ui/shell/
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chmod -R 755 /app/ui

EXPOSE 8084
ENTRYPOINT ["/entrypoint.sh"]
