# Build context: essedum-platform/ (repo root)
FROM node:20-alpine AS build

ARG NPM_REGISTRY_URL
ARG NPM_AUTH_TOKEN
ARG ARTIFACTORY_REPO_USER
ARG ARTIFACTORY_REPO_PASS

WORKDIR /workspace
COPY essedum-ui/shell/ ./shell/
WORKDIR /workspace/shell
RUN printf "registry=%s\n//infyartifactory.jfrog.io/artifactory/api/npm/npm-remote/:_authToken=%s\n" "${NPM_REGISTRY_URL}" "${NPM_AUTH_TOKEN}" > ~/.npmrc
RUN rm -f package-lock.json yarn.lock
RUN npm install --legacy-peer-deps
RUN npm run build-prod || (echo "=== Angular error log ===" && cat /tmp/ng-*/angular-errors.log 2>/dev/null && exit 1)

FROM nginx:alpine
RUN mkdir -p /etc/nginx/ssl
# Generate a self-signed cert so runtime TLS works without external cert files.
RUN apk add --no-cache openssl && \
		openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
			-subj "/CN=localhost" \
			-keyout /etc/nginx/ssl/server.key \
			-out /etc/nginx/ssl/server.crt && \
		apk del openssl

COPY essedum-ui/nginx_shell.conf /etc/nginx/nginx.conf
WORKDIR /app
RUN mkdir -p /app/ui/shell
COPY --from=build /workspace/shell/dist/shell /app/ui/shell/
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh && chmod -R 755 /app/ui

EXPOSE 8084
ENTRYPOINT ["/entrypoint.sh"]
