# =============================================================================
# AgentFlow Designer - Environment Configuration Template
# =============================================================================
# This file is safe to commit to the repository.
# It contains placeholder values only — no real credentials or internal URLs.
#
# HOW TO USE:
#   cp .env.example .env
#   Then replace the placeholder values with your actual settings.
#
# NOTE: Never commit your .env file. It is listed in .gitignore.
# All variables must be prefixed with VITE_ to be accessible in browser code.
# =============================================================================

# -----------------------------------------------------------------------------
# Dev Server
# Port the Vite dev server listens on when running: npm run dev
# -----------------------------------------------------------------------------
VITE_PORT=3000

# -----------------------------------------------------------------------------
# Backend API
# Base URL of the AgentFlow backend service.
# During development, /api/* and /health requests are proxied to this URL.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# UI / Appearance
# -----------------------------------------------------------------------------

# Image displayed on the login page.
# Use an https:// URL or a path inside the /public/ folder (e.g. /login-bg.png)
VITE_LOGIN_IMAGE_URL=https://your-image-host.com/path/to/image.png

# Browser tab title shown to users
VITE_APP_TITLE=AgentFlow Designer

# Environment label used for display/logging purposes only
# Accepted values: development | staging | production
VITE_ENVIRONMENT=development

# Agent Studio shell origin used in standalone dev mode (when NOT embedded in the shell iframe)
VITE_SHELL_ORIGIN=
