<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
	<id>assembly</id>
	<formats>
		<format>zip</format>
	</formats>
	<fileSets>
		<fileSet> <!-- Create modules directory -->
			<directory>${project.build.directory}/icip-app/modules</directory>
			<outputDirectory>modules</outputDirectory>
		</fileSet>
		<fileSet> <!-- Create modules directory -->
			<directory>${project.build.directory}/icip-app/lib</directory>
			<outputDirectory>lib</outputDirectory>
		</fileSet>		
		<fileSet> <!-- Create modules directory -->
			<directory>${project.build.directory}/icip-app/plugins</directory>
			<outputDirectory>plugins</outputDirectory>
		</fileSet>				
		<fileSet> <!-- Create log directory -->
			<outputDirectory>log</outputDirectory>
			<excludes>
				<exclude>**/*</exclude>
			</excludes>
		</fileSet>
		<fileSet> <!-- Create ui directory -->
			<outputDirectory>ui</outputDirectory>
			<excludes>
				<exclude>**/*</exclude>
			</excludes>
		</fileSet>
		<fileSet><!-- Create python directory  -->
			<outputDirectory>python</outputDirectory>
			<excludes>
				<exclude>**/*</exclude>
			</excludes>
		</fileSet>
		<fileSet> <!-- Create license directory -->
			<directory>default-license-1year</directory>
			<outputDirectory>license</outputDirectory>
		</fileSet>
		<fileSet> <!-- Create license directory -->
			<directory>${project.build.directory}/temp</directory>
			<outputDirectory>conf</outputDirectory>
		</fileSet>
		<fileSet>
			<directory>executable</directory>
			<outputDirectory>bin</outputDirectory>
			<includes>
				<include>*.bat</include>
			</includes>
			<lineEnding>dos</lineEnding>
		</fileSet>
		<fileSet>
			<directory>executable</directory>
			<outputDirectory>bin</outputDirectory>
			<includes>
				<include>*.sh</include>
			</includes>
			<lineEnding>unix</lineEnding>
			<fileMode>0755</fileMode>
		</fileSet>
	</fileSets>
	<files>
		<file>
			<source>${project.build.directory}/icip-app/common-app-${version}.jar</source> 
			<!-- <source>${project.build.directory}/icip-app/common-app-3.0-aiplat-SNAPSHOT.jar</source> -->
			<outputDirectory>/</outputDirectory>
			<destName>icip-app.jar</destName>
		</file>
	</files>
</assembly>
