# -------------------------------------------------------
# Stage 1: Build with Maven
# -------------------------------------------------------
FROM eclipse-temurin:21-jdk AS builder

RUN apt-get update && apt-get install -y maven && apt-get clean
WORKDIR /sv

# Copy project files
COPY . .

# Build using BuildKit cache for dependencies
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B clean install -Dmaven.test.skip=true -Dlicense.skip=true -Dscope.skip=true

# Prepare app structure
RUN mkdir -p /app/conf /app/lib /app/log && \
    cp /sv/common-app/src/main/resources/*.yml /app/conf && \
    cp /sv/common-app/src/main/resources/*.xml /app/conf && \
    rm -f /app/conf/application-mysql.yml && \
    if [ -f /app/conf/application-mysql-oauth2.yml ]; then \
      mv /app/conf/application-mysql-oauth2.yml /app/conf/application-mysql.yml; \
    fi && \
    cp -r /sv/app/lib /app && \
    cp /sv/common-app/target/common-app-3.3-SNAPSHOT.jar /app/

# -------------------------------------------------------
# Stage 2: Runtime Image
# -------------------------------------------------------
FROM eclipse-temurin:21-jdk

RUN apt-get update && apt-get install -y nginx && apt-get clean
COPY nginx_backend.conf /etc/nginx/nginx.conf

ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="$JAVA_HOME/bin:$PATH"

# Import SSL cert
COPY lfn-keycloak2.crt $JAVA_HOME/bin/
RUN keytool -importcert -trustcacerts \
    -file $JAVA_HOME/bin/lfn-keycloak2.crt \
    -alias "lfn-keycloak" \
    -keystore $JAVA_HOME/lib/security/cacerts \
    -storepass changeit --noprompt

# Copy built app from builder stage
COPY --from=builder /app /app/
WORKDIR /app

# --- Configurable environment variables with defaults ---
ENV ESSEDUM_HOME=/app
ENV SPRING_CONFIG_LOCATION=/app/conf/
ENV ENCRYPTION_KEY=essedum
ENV ENCRYPTION_SALT=defaultsalt
ENV LOG_PATH=/app/log
ENV SPRING_PROFILES_ACTIVE=mysql,oauth2,btf,dbconstants,vault
ENV LOG_LEVEL_SECURITY=DEBUG
ENV LOG_LEVEL_COMM_LIB=ERROR
ENV LOGBACK_CONFIG=/app/conf/logback-spring.xml

EXPOSE 8082

CMD ["/bin/bash", "-c", "\
    service nginx start && \
    java \
    -Dspring.config.location=${SPRING_CONFIG_LOCATION} \
    -Dencryption.key=${ENCRYPTION_KEY} \
    -Dencryption.salt=${ENCRYPTION_SALT} \
    -DLOG_PATH=${LOG_PATH} \
    -Dlogging.level.com.springframework.security=${LOG_LEVEL_SECURITY} \
    -Dlogging.level.com.lfn.ai.comm.lib.util.logger=${LOG_LEVEL_COMM_LIB} \
    -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE} \
    -Dorg.slf4j.simpleLogger.defaultLogLevel=info \
    -Dlogback.configurationFile=${LOGBACK_CONFIG} \
    -cp conf/*:common-app-3.3-SNAPSHOT.jar:lib/* \
    com.lfn.Common"]