	<!-- rbac-26: fix per-role menu visibility rules.
	     My Drafts (publishing) is non-monotonic: rank 1 (AI Engineer) and rank 3+
	     (Org Admin, Admin) see it, but rank 2 (Project Admin) does not.
	     Express this with a roles-override CSV; min_role_rank=99 disables the rank gate.
	     Asset Catalog: min_role_rank corrected to 1 (AI Engineer and all admin tiers). -->
	<changeSet author="Essedum (rbac)" id="rbac-26" runOnChange="false">
		<sql>
			UPDATE rbac_menu_item
			SET min_role_rank = 99, roles = 'Developer,Organization Admin,Admin'
			WHERE route = '/admin-console/publishing';

			UPDATE rbac_menu_item
			SET min_role_rank = 1, roles = NULL
			WHERE route = '/admin-console/catalog';
		</sql>
	</changeSet>

	<!-- rbac-27: fix two remaining admin-console menu visibility gaps.
	     (1) Overview min_role_rank 2→1: the frontend sets isAdminTier = roleRank >= 1,
	         so Developer (rank 1) lands on the admin-console sidebar but could not see
	         Overview because min_role_rank was 2. Lowering it to 1 aligns the data with
	         the frontend boundary without touching any other items.
	     (2) My Drafts roles CSV: rbac-26 omitted 'Project Admin' from the override list,
	         so Project Admin (rank 2) never received the item. All four admin-console tiers
	         (Developer, Project Admin, Organization Admin, Admin) publish drafts and must
	         see My Drafts. min_role_rank=99 stays — the roles column is the sole gate. -->
	<changeSet author="Essedum (rbac)" id="rbac-27">
		<sql>
			UPDATE rbac_menu_item
			SET min_role_rank = 1
			WHERE route = '/admin-console/overview';

			UPDATE rbac_menu_item
			SET roles = 'Developer,Project Admin,Organization Admin,Admin'
			WHERE route = '/admin-console/publishing';
		</sql>
	</changeSet>

	<!-- rbac-28: AI Client (legacy usm_role 'Viewer') was seeded as a read-only role —
	     usm_permission_api only ever granted it GET methods, so CustomAuthorizationManager
	     returns 403 for every PUT/POST/DELETE against pipelines, datasets, connections and
	     streaming services (rbac-21 only renamed the *new* rbac_role/menu row, it never
	     touched the legacy usm_role/usm_role_permissions grants that actually gate each API
	     call). AI Client is now required to perform data updates, so copy the write-method
	     grants already proven for 'Developer' onto the matching 'Viewer'/'AI Client' usm_role
	     row(s), correlating by project scope so project-specific role rows don't cross-pollinate
	     with other projects' grants. Idempotent: only inserts (permission, role) pairs that
	     don't already exist. -->
	<changeSet author="Essedum (rbac)" id="rbac-28">
		<sql>
			INSERT INTO usm_role_permissions (permission, role)
			SELECT DISTINCT p.id, client_role.id
			FROM usm_role client_role
					 JOIN usm_role dev_role
						  ON (dev_role.project_id IS NULL AND client_role.project_id IS NULL)
							  OR (dev_role.project_id = client_role.project_id)
				     JOIN usm_role_permissions rp ON rp.role = dev_role.id
				     JOIN usm_permissions p ON p.id = rp.permission
				     JOIN usm_permission_api pa ON pa.permission_id = p.id
			WHERE LOWER(client_role.name) IN ('viewer', 'ai client')
			  AND LOWER(dev_role.name) = 'developer'
			  AND UPPER(pa.type) IN ('PUT', 'POST', 'DELETE')
			  AND (
				LOWER(pa.api) LIKE '%pipeline%'
					OR LOWER(pa.api) LIKE '%dataset%'
					OR LOWER(pa.api) LIKE '%datasource%'
					OR LOWER(pa.api) LIKE '%connection%'
					OR LOWER(pa.api) LIKE '%streamingservices%'
				)
			  AND NOT EXISTS (
				SELECT 1 FROM usm_role_permissions rp2
				WHERE rp2.role = client_role.id AND rp2.permission = p.id
			);
		</sql>
	</changeSet>

