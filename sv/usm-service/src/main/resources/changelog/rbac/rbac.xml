	<!-- Promote portfolios to first-class Organizations (roadmap §1 tenancy schema).
	     Portfolio is dropped as a concept: each usm_portfolio becomes the
	     organisation its projects belong to (1:1 by id), and usm_project.organisation_id
	     is backfilled so org-scoped visibility (§4) resolves. usm_portfolio is left
	     in place but dormant. Runs once; new projects set organisation_id at creation. -->
	<changeSet author="Essedum (rbac)" id="rbac-16">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="1">
				SELECT CASE WHEN EXISTS (
					SELECT 1 FROM usm_project WHERE organisation_id IS NULL AND portfolio_id IS NOT NULL
				) THEN 1 ELSE 0 END
			</sqlCheck>
		</preConditions>
		<sql>UPDATE usm_organisation o JOIN usm_portfolio p ON p.id = o.id SET o.name = p.portfolio_name</sql>
		<sql>INSERT INTO usm_organisation (id, name, status)
			SELECT p.id, p.portfolio_name, 'active' FROM usm_portfolio p
			WHERE NOT EXISTS (SELECT 1 FROM usm_organisation o WHERE o.id = p.id)</sql>
		<sql>UPDATE usm_project SET organisation_id = portfolio_id
			WHERE organisation_id IS NULL AND portfolio_id IS NOT NULL</sql>
	</changeSet>

	<!-- rbac-17: rbac_role.name is user-visible, not just a key — the bridge names
	     legacy usm_role rows after it, sidebars are keyed "<name> Side", and it
	     shows in the shell header's Role switcher. Rename the seeded roles to
	     display form so every dropdown reads properly. Legacy same-named roles
	     are retired first by changelog/rbac/manual-apply.sql (rbac-20). -->
	<changeSet author="Essedum (rbac)" id="rbac-17">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="1">
				SELECT CASE WHEN EXISTS (
					SELECT 1 FROM rbac_role WHERE name IN
						('platform_admin', 'org_admin', 'project_admin', 'developer', 'viewer')
				) THEN 1 ELSE 0 END
			</sqlCheck>
		</preConditions>
		<sql>UPDATE rbac_role SET name = 'Admin' WHERE name = 'platform_admin'</sql>
		<sql>UPDATE rbac_role SET name = 'Organization Admin' WHERE name = 'org_admin'</sql>
		<sql>UPDATE rbac_role SET name = 'Project Admin' WHERE name = 'project_admin'</sql>
		<sql>UPDATE rbac_role SET name = 'Developer' WHERE name = 'developer'</sql>
		<sql>UPDATE rbac_role SET name = 'Viewer' WHERE name = 'viewer'</sql>
		<sql>UPDATE usm_constant SET item = 'Admin Side' WHERE item = 'platform_admin Side'</sql>
		<sql>UPDATE usm_constant SET item = 'Organization Admin Side' WHERE item = 'org_admin Side'</sql>
		<sql>UPDATE usm_constant SET item = 'Project Admin Side' WHERE item = 'project_admin Side'</sql>
		<sql>UPDATE usm_constant SET item = 'Developer Side' WHERE item = 'developer Side'</sql>
		<sql>UPDATE usm_constant SET item = 'Viewer Side' WHERE item = 'viewer Side'</sql>
	</changeSet>

	<!-- rbac-18: flatten the admin menu. The shell renders rbac_menu_item as a flat
	     list (appendRbacMenu ignores parentId), so the "Admin Console" parent was
	     only an extra row pointing at /admin-console — which redirects to overview
	     and duplicated the Overview entry. It was also min_role_rank 0, showing an
	     admin link to viewers. Drop it and null the now-meaningless parent links. -->
	<changeSet author="Essedum (rbac)" id="rbac-18">
		<preConditions onFail="MARK_RAN">
			<sqlCheck expectedResult="1">
				SELECT CASE WHEN EXISTS (
					SELECT 1 FROM rbac_menu_item WHERE route = '/admin-console'
				) THEN 1 ELSE 0 END
			</sqlCheck>
		</preConditions>
		<sql>DELETE FROM rbac_menu_item WHERE route = '/admin-console'</sql>
		<sql>UPDATE rbac_menu_item SET parent_id = NULL WHERE parent_id IS NOT NULL</sql>
		<sql>UPDATE rbac_menu_item SET display_order = 0 WHERE route = '/admin-console/overview'</sql>
	</changeSet>

