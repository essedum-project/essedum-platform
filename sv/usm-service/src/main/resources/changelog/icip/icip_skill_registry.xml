	<!-- ================================================================
	     Soft-delete safe re-create: drop the naive unique constraint and
	     replace with a partial uniqueness approach.
	     MySQL does not support partial indexes natively, so we use a
	     generated virtual column trick:
	       active_key = CASE WHEN deleted = 0 THEN id ELSE NULL END
	     The unique constraint on (skill_name, skill_version, organization, active_key)
	     allows multiple deleted rows with the same name+version+org but only
	     one active (non-deleted) row.
	     Split into 2 changeSets:
	       2026070608a — drop old index (MySQL 5.7 compatible via Liquibase dropIndex)
	       2026070608b — add virtual column + new unique constraint
	     ================================================================ -->

	<!-- Step 1: Drop old unique constraint only if it exists -->
	<changeSet author="Essedum (generated)" id="2026070608a-icip-skill-registry-drop-old-unique">
		<validCheckSum>any</validCheckSum>
		<preConditions onFail="MARK_RAN">
			<indexExists tableName="icip_skill_registry" indexName="uk_skill_name_version_org"/>
		</preConditions>
		<dropIndex tableName="icip_skill_registry" indexName="uk_skill_name_version_org"/>
	</changeSet>

	<!-- Step 2: Add virtual column + soft-delete-safe unique constraint -->
	<changeSet author="Essedum (generated)" id="2026070608b-icip-skill-registry-soft-delete-unique">
		<validCheckSum>any</validCheckSum>
		<preConditions onFail="MARK_RAN">
			<not>
				<columnExists tableName="icip_skill_registry" columnName="active_key"/>
			</not>
		</preConditions>
		<sql splitStatements="true" stripComments="true">
			ALTER TABLE icip_skill_registry ADD COLUMN active_key VARCHAR(64) AS (CASE WHEN deleted = 0 THEN skill_uid ELSE NULL END) VIRTUAL;
			ALTER TABLE icip_skill_registry ADD CONSTRAINT uk_skill_name_version_org_active UNIQUE (skill_name, skill_version, organization, active_key);
		</sql>
	</changeSet>

