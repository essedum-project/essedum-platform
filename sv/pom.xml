        <liquibase.version>4.8.0</liquibase.version>

        <!-- ── Cache ─────────────────────────────────────────────────── -->
        <ehcache.version>3.10.8</ehcache.version>

        <!-- ── HTTP Clients ──────────────────────────────────────────────
             Both httpclient 4.x and httpclient5 5.x were declared in every
             service. Spring Boot 3.x internally requires httpclient5.
             httpclient 4.x is kept here for backward-compat with legacy
