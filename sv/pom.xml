    <!-- ════════════════════════════════════════════════════════════════════
         CHANGE 4 ▸ Lombok annotation processor — explicit annotationProcessorPaths.
         With multi-level POM inheritance (service → sv → spring-boot-starter-parent),
         Lombok's annotation processor is not always auto-discovered from the
         provided-scope dependency alone. Declaring it explicitly in
         annotationProcessorPaths guarantees @Getter/@Setter/@Log4j2 etc. are
         processed on every service without needing per-service plugin config.
         ════════════════════════════════════════════════════════════════════ -->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

