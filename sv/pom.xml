<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ════════════════════════════════════════════════════════════════════
         CHANGE 1 ▸ Root POM now inherits Spring Boot BOM.
         All child modules inherit transitively — no need to re-declare parent
         in each child. Spring Boot's plugin + dependency management flows down.
         ════════════════════════════════════════════════════════════════════ -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lfn.ai</groupId>
    <artifactId>essedum-platform-sv</artifactId>
    <version>3.3-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Essedum Platform – Backend Services Aggregator</name>

    <modules>
        <module>api-gateway</module>
        <module>usm-service</module>
        <module>icip-service</module>
        <module>data-service</module>
        <module>vibe-service</module>
    </modules>

    <!-- ════════════════════════════════════════════════════════════════════
         CHANGE 2 ▸ Single source of truth for ALL dependency versions.
         Previously each service repeated these independently, causing:
           • version drift (e.g. jjwt 0.11.2 vs 0.11.5 across services)
           • ~70 duplicate property lines per service
           • risk of missing a security patch in one service
         Now update here once → all services pick it up automatically.
         ════════════════════════════════════════════════════════════════════ -->
    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- ── Spring Ecosystem ───────────────────────────────────────────
             spring-framework.version and spring-security.version are special:
             spring-boot-starter-parent reads these properties to let you
             override the Spring Framework / Security version it manages.     -->
        <spring-security.version>6.5.10</spring-security.version>
        <spring-framework.version>6.2.18</spring-framework.version>
        <spring-cloud.version>4.1.3</spring-cloud.version>
        <spring-vault-core.version>3.1.1</spring-vault-core.version>

        <!-- ── JWT ───────────────────────────────────────────────────────
             Centralized: icip-service, usm-service, data-service, vibe-service
             all used 0.11.2 — preserved here at 0.11.2 (no upgrade).
             api-gateway was already at 0.11.5 and overrides this in its own
             <properties> block to keep its original version unchanged.      -->
        <jjwt.version>0.11.2</jjwt.version>

        <!-- ── Jackson ───────────────────────────────────────────────────
             spring-boot-starter-parent manages Jackson but we pin it
             explicitly so the version is visible at a glance.               -->
        <jackson.version>2.18.6</jackson.version>

        <!-- ── OpenAPI / Swagger ─────────────────────────────────────────
