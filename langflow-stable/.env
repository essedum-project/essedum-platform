# Langflow Stable Configuration
LANGFLOW_PORT=7861
LANGFLOW_HOST=0.0.0.0

# PostgreSQL Configuration
POSTGRES_DB=langflowfb
POSTGRES_USER=langflow
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433

# PostgreSQL Database Connection URL
LANGFLOW_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Security
LANGFLOW_SECRET_KEY=langflow-stable-secret-key-2026

# Langflow Settings
LANGFLOW_LOG_LEVEL=INFO
