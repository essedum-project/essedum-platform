# Langflow Environment Configuration Template
# Copy this file to .env and fill in your actual values
# .env file is gitignored and will not be committed

# Database Configuration
POSTGRES_HOST=postgres.aipns.svc.cluster.local
POSTGRES_PORT=5432
POSTGRES_DB=langflowdb
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_secure_password

# Langflow Database URL (used by application)
LANGFLOW_DATABASE_URL=postgresql://your_db_user:your_secure_password@postgres.aipns.svc.cluster.local:5432/langflowdb

# Langflow Application Settings
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_ENV=production

# Security Settings
LANGFLOW_AUTO_LOGIN=false
# LANGFLOW_SECRET_KEY=generate_with_openssl_rand_hex_32

# Optional: CORS Configuration
# LANGFLOW_CORS_ORIGINS=https://yourdomain.com

# Optional: Upload Settings
# LANGFLOW_MAX_FILE_SIZE=100

# Optional: Worker Configuration
# LANGFLOW_WORKERS=4

# Optional: Logging
# LANGFLOW_LOG_LEVEL=INFO

# Namespace for Kubernetes deployment
K8S_NAMESPACE=aipns
K8S_DEPLOYMENT_NAME=langflow-persistent
