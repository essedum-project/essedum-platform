# PostgreSQL
POSTGRES_USER=langfuse
POSTGRES_PASSWORD=REDACTED_LANGFUSE_PG_PASSWORD
POSTGRES_DB=langfuse
POSTGRES_HOST_PORT=5432

# ClickHouse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=REDACTED_CLICKHOUSE_PASSWORD
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# Redis
REDIS_PASSWORD=REDACTED_REDIS_PASSWORD
REDIS_HOST_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=langfuse-minio
MINIO_ROOT_PASSWORD=REDACTED_LANGFUSE_MINIO_PASSWORD
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET=langfuse
MINIO_REGION=us-east-1

# Langfuse secrets
SALT=REDACTED_LANGFUSE_SALT
ENCRYPTION_KEY=REDACTED_LANGFUSE_ENCRYPTION_KEY

# Langfuse feature flags
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

# Connection strings
DATABASE_URL=postgresql://langfuse:REDACTED_LANGFUSE_PG_PASSWORD@postgres:5432/langfuse
CLICKHOUSE_MIGRATION_URL=clickhouse://default:REDACTED_CLICKHOUSE_PASSWORD@clickhouse:9000
CLICKHOUSE_URL=http://default:REDACTED_CLICKHOUSE_PASSWORD@clickhouse:8123
REDIS_CONNECTION_STRING=redis://:REDACTED_REDIS_PASSWORD@redis:6379

# S3 / MinIO
LANGFUSE_S3_ENDPOINT=http://minio:9000
LANGFUSE_S3_FORCE_PATH_STYLE=true

# Web
NEXTAUTH_URL=https://10.200.111.174:8084/langfuse/
NEXT_PUBLIC_BASE_PATH=/langfuse
NEXTAUTH_SECRET=REDACTED_LANGFUSE_NEXTAUTH_SECRET
WEB_HOST_PORT=3000

# Worker
WORKER_HOST_PORT=3030
