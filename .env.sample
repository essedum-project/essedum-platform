# =============================================================================
# Essedum Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment:
#   cp .env.sample .env
# =============================================================================

# --- Host Port Mappings (exposed on the host machine) ---
BACKEND_PORT=8082
FRONTEND_PORT=8084

# =============================================================================
# FRONTEND Configuration
# =============================================================================

# --- Nginx Proxy Targets (internal Docker networking) ---
BACKEND_SERVICE_URL=essedum-backend-service:8082
LANGFLOW_SERVICE_URL=essedum-langflow-service:80
LANGFUSE_SERVICE_URL=essedum-langfuse-service:3000
LITELLM_SERVICE_URL=essedum-litellm-service:4000

# --- Auth Config (shell-app runtime config) ---
FE_AUTH_REQUIRED=false
FE_AUTH_ISSUER=https://login.microsoftonline.com/63ce7d59-2f3e-42cd-a8cc-be764cff5eb6/v2.0
FE_AUTH_CLIENT_ID=4c08c00f-c434-4846-85cb-544e8feb0843
FE_AUTH_SCOPE=4c08c00f-c434-4846-85cb-544e8feb0843/.default

# --- Langflow URL (injected into aip-app JS at container startup) ---
FE_LANGFLOW_URL=https://langflow.essedum-lfn.infosys.com/
FE_LANGFUSE_URL=https://langfuse.essedum-lfn.infosys.com/
FE_LITELLM_URL=https://litellm.essedum-lfn.infosys.com/ui/

# --- Pipeline Config (aip-app runtime config) ---
FE_MINIO_ENDPOINT=http://minio:9000
FE_MINIO_BUCKET=aiptest
FE_CONTAINER_REGISTRY_PREFIX=localhost:5000
FE_CONTAINER_REGISTRY_VERSION=v1

# =============================================================================
# BACKEND Configuration
# =============================================================================

# --- Encryption & License ---
ENCRYPTION_KEY=essedum
ENCRYPTION_SALT=defaultsalt
LICENSE=
PUBLIC_KEY=

# --- Spring Profiles ---
SPRING_PROFILES_ACTIVE=mysql,oauth2,btf,dbconstants,vault

# --- Database (MySQL) ---
MYSQL_DATASOURCE_URL=jdbc:mysql://mysql:3306
MYSQL_DATASOURCE_USER=root
MYSQL_DATASOURCE_PASS=password

# --- Database Names ---
ESSEDUM_CORE_DB=essedum_coredb
ESSEDUM_QUARTZ_DB=essedum_quartzdb
ESSEDUM_BTF_DB=essedum_btf
ESSEDUM_SJS_DB=essedum_sjs
ESSEDUM_REF_DB=essedum_ref_data

# --- Telemetry Database ---
TELEMETRY_DATASOURCE_URL=jdbc:mysql://mysql:3306/telemetrydb

# --- Self URLs (how backend identifies itself) ---
ESSEDUM_URL=http://essedum-backend-service:8082/
COMMON_APP_URL=http://essedum-backend-service:8081/

# --- Python Job Executor ---
PYJOB_EXECUTOR_URL=http://py-job-executor:5000

# --- Vault ---
VAULT_ENABLED=false
VAULT_URL=http://vault:8200
VAULT_TOKEN=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# --- Server Port (Spring Boot internal) ---
BACKEND_SERVER_PORT=8081

# --- OAuth2 / Keycloak ---
OAUTH2_ISSUER_URI=https://login.essedum-lfn.infosys.com/realms/ESSEDUM
OAUTH2_JWK_SET_URI=https://login.essedum-lfn.infosys.com/realms/ESSEDUM/protocol/openid-connect/certs
OAUTH2_CLIENT_ID=essedum-45
OAUTH2_SCOPE=openid profile email
OAUTH2_CLAIM=email||admin
OAUTH2_CREATE_USER=true


