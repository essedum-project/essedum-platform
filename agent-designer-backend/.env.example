# Application
APP_NAME="AgentFlow Designer API"
APP_VERSION="1.0.0"
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant (V1 vector store)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_GRPC=false

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-01

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google Vertex AI
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=us-central1
# Path to service account JSON, or leave empty for ADC
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Salus Responsible-AI (privacy + moderation)
# Set SALUS_ENABLED=true to activate. All other settings have safe defaults.
# ---------------------------------------------------------------------------
SALUS_ENABLED=false
SALUS_MODERATION_URL=http://localhost:30000
SALUS_PRIVACY_URL=http://localhost:30002

# HTTP timeout (seconds) for Salus API calls
SALUS_TIMEOUT=10.0

# fail-closed=true  → block LLM call when Salus is unreachable (HTTP 503)
# fail-closed=false → log the error and let the call through (default)
SALUS_FAIL_CLOSED=false

# Comma-separated Salus check names applied to the prompt (input)
# Options: PromptInjection, JailBreak, Toxicity, Piidetct, Refusal,
#          Profanity, RestrictTopic, TextQuality, CustomizedTheme
SALUS_INPUT_CHECKS_RAW=PromptInjection,JailBreak,Toxicity,Piidetct,Profanity

# Comma-separated Salus check names applied to the LLM response (output)
SALUS_OUTPUT_CHECKS_RAW=Toxicity,Piidetct,Profanity,Refusal

# Comma-separated PII entity types to detect and redact (empty = skip PII step)
# Example: US_SSN,CREDIT_CARD,EMAIL_ADDRESS,PHONE_NUMBER,IN_AADHAAR,IN_PAN
SALUS_PII_ENTITIES_RAW=

# PII detection confidence threshold (0–1)
SALUS_PII_SCORE_THRESHOLD=0.40

# Moderation decision thresholds (0–1)
SALUS_PROMPT_INJECTION_THRESHOLD=0.70
SALUS_JAILBREAK_THRESHOLD=0.70
SALUS_REFUSAL_THRESHOLD=0.70
SALUS_TOXICITY_THRESHOLD=0.60
